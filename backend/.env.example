# Port Configuration
PORT=3001

# Payment Gateway Configuration
PAYMENTS_MODE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS Gateway Configuration
SMS_MODE=
MSG91_AUTH_KEY=
SMS_API_KEY=
SMS_SENDER_ID=

# Email Service Configuration
EMAIL_MODE=
EMAIL_MOCK=
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# WhatsApp Configuration
WHATSAPP_MODE=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Cloudflare R2 Storage Configuration
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=

# JWT Session Configuration
JWT_SECRET=

# Postgres Configuration
# For tests: use in-memory pg-mem
POSTGRES_MODE=mem

# For local dev or production against real Postgres:
# DATABASE_URL=

# Seed Mode Configuration
# Options: production (default, seed nothing), test (used by regression suite)
SEED_MODE=production
